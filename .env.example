# NextMonitor-Core environment

COMPOSE_PROJECT_NAME=nextmonitor

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nextmonitor_admin

# Prometheus
PROMETHEUS_PORT=9090

# Loki
LOKI_PORT=3100

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Uptime Kuma
UPTIME_KUMA_PORT=3001
